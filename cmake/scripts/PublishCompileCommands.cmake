# Usage: cmake -DSOURCE=<compile_commands.json> -DDESTINATION=<copy> -P PublishCompileCommands.cmake
# The copy is for clangd and clang-tidy: they cannot read MSVC precompiled headers, so the
# PCH use flags are dropped and the forced include of the PCH header is parsed instead.

function(quote_json_string text outputVariable)
	string(REPLACE "\\" "\\\\" escapedText "${text}")
	string(REPLACE "\"" "\\\"" escapedText "${escapedText}")
	set(${outputVariable} "\"${escapedText}\"" PARENT_SCOPE)
endfunction()

file(READ "${SOURCE}" compileCommands)

string(REGEX REPLACE " /Y[cu][^ \"]+" "" compileCommands "${compileCommands}")
string(REGEX REPLACE " /Fp[^ \"]+" "" compileCommands "${compileCommands}")
string(REPLACE " -Winvalid-pch" "" compileCommands "${compileCommands}")
string(REPLACE " /WX " " /WX -Wno-unused-command-line-argument " compileCommands "${compileCommands}")

# CMake lists no headers. clangd then borrows the command of a neighbouring source and loses the
# language standard of MSVC-style commands on the way, so every header gets such a command here:
# the one of a source in its folder or, for a folder without sources, in a folder below it.
cmake_path(ABSOLUTE_PATH DESTINATION NORMALIZE OUTPUT_VARIABLE destinationPath)
cmake_path(GET destinationPath PARENT_PATH buildDirectory)
cmake_path(GET buildDirectory PARENT_PATH projectDirectory)
string(JSON sourceCount LENGTH "${compileCommands}")
math(EXPR lastSourceIndex "${sourceCount} - 1")
set(coveredHeaders "")
set(entryCount ${sourceCount})
foreach(sourceIndex RANGE ${lastSourceIndex})
	string(JSON sourceEntry GET "${compileCommands}" ${sourceIndex})
	string(JSON sourceFile GET "${sourceEntry}" file)
	string(JSON sourceCommand GET "${sourceEntry}" command)
	cmake_path(GET sourceFile PARENT_PATH sourceDirectory)
	cmake_path(NATIVE_PATH sourceFile nativeSourceFile)
	file(GLOB directoryHeaders "${sourceDirectory}/*.h" "${sourceDirectory}/*.hpp")
	cmake_path(GET sourceDirectory PARENT_PATH ancestorDirectory)
	cmake_path(IS_PREFIX projectDirectory "${ancestorDirectory}" NORMALIZE isInsideProject)
	cmake_path(IS_PREFIX buildDirectory "${ancestorDirectory}" NORMALIZE isInsideBuild)
	while(isInsideProject AND NOT isInsideBuild AND NOT ancestorDirectory STREQUAL projectDirectory)
		file(GLOB ancestorHeaders "${ancestorDirectory}/*.h" "${ancestorDirectory}/*.hpp")
		list(APPEND directoryHeaders ${ancestorHeaders})
		set(previousDirectory "${ancestorDirectory}")
		cmake_path(GET ancestorDirectory PARENT_PATH ancestorDirectory)
		if(ancestorDirectory STREQUAL previousDirectory)
			break()
		endif()
		cmake_path(IS_PREFIX projectDirectory "${ancestorDirectory}" NORMALIZE isInsideProject)
	endwhile()
	foreach(headerFile IN LISTS directoryHeaders)
		if(headerFile IN_LIST coveredHeaders)
			continue()
		endif()
		list(APPEND coveredHeaders "${headerFile}")
		cmake_path(NATIVE_PATH headerFile nativeHeaderFile)
		string(REPLACE "${nativeSourceFile}" "${nativeHeaderFile}" headerCommand "${sourceCommand}")
		quote_json_string("${headerFile}" headerFileJson)
		quote_json_string("${headerCommand}" headerCommandJson)
		string(JSON headerEntry REMOVE "${sourceEntry}" output)
		string(JSON headerEntry SET "${headerEntry}" file "${headerFileJson}")
		string(JSON headerEntry SET "${headerEntry}" command "${headerCommandJson}")
		string(JSON compileCommands SET "${compileCommands}" ${entryCount} "${headerEntry}")
		math(EXPR entryCount "${entryCount} + 1")
	endforeach()
endforeach()

if(EXISTS "${DESTINATION}")
	file(READ "${DESTINATION}" publishedCompileCommands)
	if(publishedCompileCommands STREQUAL compileCommands)
		return()
	endif()
endif()

file(WRITE "${DESTINATION}.tmp" "${compileCommands}")
file(RENAME "${DESTINATION}.tmp" "${DESTINATION}")
