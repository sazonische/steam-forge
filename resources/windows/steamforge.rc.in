#include <winver.h>

IDI_ICON1 ICON "@STEAMFORGE_ICON_DIRECTORY@/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @STEAMFORGE_VERSION_MAJOR@,@STEAMFORGE_VERSION_MINOR@,@STEAMFORGE_VERSION_PATCH@,0
PRODUCTVERSION @STEAMFORGE_VERSION_MAJOR@,@STEAMFORGE_VERSION_MINOR@,@STEAMFORGE_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "sazonische"
			VALUE "FileDescription", "SteamForge"
			VALUE "FileVersion", "@STEAMFORGE_VERSION@"
			VALUE "InternalName", "SteamForge"
			VALUE "LegalCopyright", "Copyright (c) 2026 sazonische. MIT License."
			VALUE "OriginalFilename", "SteamForge.exe"
			VALUE "ProductName", "SteamForge"
			VALUE "ProductVersion", "@STEAMFORGE_VERSION@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
